diff --git a/docs/usage.rst b/docs/usage.rst
index 9d61f5c..8e6b4f0 100644
--- a/docs/usage.rst
+++ b/docs/usage.rst
@@ -550,6 +550,12 @@ To remove a table from a database, use:
 
 >>> db.drop_table('table_name')
 
+To rename a table and keep its documents, use:
+
+>>> db.rename_table('table_name', 'new_name')
+
+It raises ``ValueError`` if the table does not exist or the new name is already taken.
+
 If on the other hand you want to remove all tables, use the counterpart:
 
 >>> db.drop_tables()
diff --git a/tests/test_tinydb.py b/tests/test_tinydb.py
index 9ff866f..3238c93 100644
--- a/tests/test_tinydb.py
+++ b/tests/test_tinydb.py
@@ -837,3 +837,28 @@ def test_lambda_query():
     query.is_cacheable = lambda: False
     assert db.search(query) == [{'foo': 'bar'}]
     assert not db._query_cache
+
+
+def test_rename_table_keeps_documents(db):
+    db.table('old').insert({'x': 1})
+    db.rename_table('old', 'new')
+    assert 'old' not in db.tables() and db.table('new').all() == [{'x': 1}]
+
+
+def test_rename_table_refuses_to_overwrite(db):
+    db.table('a').insert({'x': 1})
+    db.table('b').insert({'x': 2})
+    with pytest.raises(ValueError):
+        db.rename_table('a', 'b')
+
+
+def test_rename_missing_table_raises(db):
+    with pytest.raises(ValueError):
+        db.rename_table('nope', 'other')
+
+
+def test_rename_table_does_not_serve_stale_cached_results(db):
+    db.table('old').insert({'x': 1})
+    assert db.table('new').search(where('x') == 1) == []
+    db.rename_table('old', 'new')
+    assert db.table('new').search(where('x') == 1) == [{'x': 1}]
diff --git a/tinydb/database.py b/tinydb/database.py
index 0cd2b7e..a34772c 100644
--- a/tinydb/database.py
+++ b/tinydb/database.py
@@ -201,6 +201,34 @@ class TinyDB(TableBase):
         # Store the updated data back to the storage
         self.storage.write(data)
 
+    def rename_table(self, old_name: str, new_name: str) -> None:
+        """
+        Rename a table, keeping all of its documents.
+
+        :param old_name: The current name of the table.
+        :param new_name: The new name of the table.
+        :raises ValueError: if ``old_name`` does not exist or if a table
+                            called ``new_name`` already exists.
+        """
+        data = self.storage.read() or {}
+
+        if old_name not in data:
+            raise ValueError(f'Table {old_name!r} does not exist')
+
+        if new_name in data:
+            raise ValueError(f'Table {new_name!r} already exists')
+
+        data[new_name] = data.pop(old_name)
+        self.storage.write(data)
+
+        # Forget the table instances for both names and clear their query
+        # caches, so neither old references nor new lookups serve stale
+        # results.
+        for name in (old_name, new_name):
+            table = self._tables.pop(name, None)
+            if table is not None:
+                table.clear_cache()
+
     @property
     def storage(self) -> Storage:
         """
