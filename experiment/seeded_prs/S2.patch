+def test_update_multiple_generator(db: TinyDB):
+    ids = db.update_multiple(
+        ({'int': n}, where('char') == c) for n, c in [(7, 'a'), (8, 'b')]
+    )
+
+    assert sorted(ids) == [1, 2]
+    assert db.count(where('int') == 7) == 1
+    assert db.count(where('int') == 8) == 1
